{
  "entities": {
    "UserSite": {
      "title": "UserSite",
      "description": "A website generated by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the owner." },
        "title": { "type": "string", "description": "The title of the site." },
        "description": { "type": "string", "description": "Short description." },
        "html": { "type": "string", "description": "The HTML content." },
        "theme": {
          "type": "object",
          "properties": {
            "primaryColor": { "type": "string" },
            "secondaryColor": { "type": "string" },
            "fontFamily": { "type": "string" }
          },
          "required": ["primaryColor", "secondaryColor", "fontFamily"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "slug": { "type": "string", "description": "Unique URL slug." },
        "isPublished": { "type": "boolean", "description": "Whether the site is live." },
        "views": { "type": "number", "description": "Number of views." }
      },
      "required": ["userId", "title", "html", "theme", "createdAt", "slug"]
    }
  },
  "firestore": {
    "/sites/{siteId}": {
      "schema": "UserSite",
      "description": "Collection of all generated websites."
    }
  }
}
